{
  "name": "tauri-template",
  "type": "module",
  "version": "1.19.0",
  "packageManager": "pnpm@10.18.2",
  "description": "vite + vue3 + ts + tauri 开箱即用现代开发模板",
  "engines": {
    "node": ">=20.12.2"
  },
  "scripts": {
    "dev": "vite --host --open",
    "build": "vite build",
    "preview": "vite preview",
    "preinstall": "npx only-allow pnpm",
    "typecheck": "npx vue-tsc --noEmit",
    "preview:host": "vite preview --host",
    "preview:open": "vite preview --open",
    "lint": "eslint .",
    "build:debug": "cross-env NODE_ENV=debug vite build",
    "lint:fix": "eslint --fix .",
    "tauri": "tauri dev"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.2.0",
    "@iconify-json/ep": "^1.2.3",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/mdi": "^1.2.3",
    "@intlify/unplugin-vue-i18n": "^11.0.1",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/cli": "^2.9.4",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@types/ityped": "^1.0.3",
    "@types/node": "^20.19.20",
    "@typescript-eslint/parser": "^8.47.0",
    "@unocss/eslint-config": "^66.5.9",
    "@unocss/preset-wind4": "^66.5.9",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vueuse/components": "^14.0.0",
    "@vueuse/core": "^14.0.0",
    "@vueuse/integrations": "^14.0.0",
    "axios": "^1.13.2",
    "browserslist": "^4.28.0",
    "cross-env": "^10.1.0",
    "defu": "^6.1.4",
    "echarts": "^6.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-format": "^1.0.2",
    "fs-extra": "^11.3.2",
    "ityped": "^1.0.3",
    "lightningcss": "^1.30.2",
    "lint-staged": "^16.2.7",
    "local-pkg": "^1.1.2",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "unocss": "^66.5.9",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "unplugin-vue-router": "^0.17.1",
    "vite": "^7.2.4",
    "vite-auto-import-resolvers": "^3.2.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-env-types": "^0.1.4",
    "vite-plugin-legacy-swc": "^2.0.1",
    "vite-plugin-use-modules": "^1.4.8",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vite-plugin-vue-meta-layouts": "^0.6.1",
    "vue": "^3.5.25",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.2.1",
    "vue-request": "2.0.4",
    "vue-router": "^4.6.3"
  },
  "overrides": {
    "array-includes": "npm:@nolyfill/array-includes@latest",
    "array.prototype.findlastindex": "npm:@nolyfill/array.prototype.findlastindex@latest",
    "array.prototype.flat": "npm:@nolyfill/array.prototype.flat@latest",
    "array.prototype.flatmap": "npm:@nolyfill/array.prototype.flatmap@latest",
    "arraybuffer.prorotype.slice": "npm:@nolyfill/arraybuffer.prorotype.slice@latest",
    "function.prototype.name": "npm:@nolyfill/function.prototype.name@latest",
    "has": "npm:@nolyfill/has@latest",
    "is-regex": "npm:@nolyfill/is-regex@latest",
    "object-keys": "npm:@nolyfill/object-keys@latest",
    "object.assign": "npm:@nolyfill/object.assign@latest",
    "object.entries": "npm:@nolyfill/object.entries@latest",
    "object.fromentries": "npm:@nolyfill/object.fromentries@latest",
    "object.values": "npm:@nolyfill/object.values@latest",
    "sourcemap-codec": "npm:@jridgewell/sourcemap-codec@latest",
    "vue-demi": "npm:vue-demi@latest"
  },
  "lint-staged": {
    "*.{js,ts,vue}": "eslint --fix"
  },
  "browserslist": [
    ">= 0.25%",
    "last 2 versions",
    "not dead",
    "not ie <= 11",
    "Android >= 4.0",
    "iOS >= 8"
  ]
}
